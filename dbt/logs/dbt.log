        user_id,
        product_id,
        quantity,
        order_ts,
        _cdc_op,
        _cdc_ts,
        row_number() over (
            partition by id
            order by _cdc_ts desc
        ) as rn
    from raw_orders
)

select
    order_id,
    user_id,
    product_id,
    quantity,
    order_ts,
    toDate(order_ts) as order_date
from ranked
where rn = 1
  and _cdc_op != 'd'
  )
      
      
